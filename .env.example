NODE_ENV=development

# Serviços
WEB_PORT=3000
API_PORT=4000
INGESTION_GRPC_PORT=4319
API_URL=http://api:4000
NEXT_PUBLIC_API_URL=http://localhost/api

# Neon PostgreSQL
# Copie as duas conexões do mesmo banco no painel do Neon.
# Runtime: conexão pooled, cujo hostname contém "-pooler".
DATABASE_URL=postgresql://USUARIO:SENHA@ep-exemplo-pooler.REGIAO.aws.neon.tech/observability?sslmode=require
# Migrations e administração: conexão direta, sem "-pooler" no hostname.
DATABASE_URL_UNPOOLED=postgresql://USUARIO:SENHA@ep-exemplo.REGIAO.aws.neon.tech/observability?sslmode=require

# Segredos: substitua antes de qualquer implantação.
JWT_SECRET=change-me-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
PROJECT_KEY_PEPPER=change-me-with-at-least-32-random-characters

# Retenção inicial do MVP
TRACE_RETENTION_DAYS=7

# Aplicação demonstrativa (use uma conexão pooled de um banco Neon separado)
DEMO_OBS_PROJECT_KEY=
DEMO_OBS_ENVIRONMENT=development
DEMO_OBS_SERVICE_NAME=demo-store-server
DEMO_DATABASE_URL=postgresql://USUARIO:SENHA@ep-demo-pooler.REGIAO.aws.neon.tech/demo?sslmode=require
