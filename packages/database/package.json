{
  "name": "@tcc-observability/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./src/generated/prisma/client.ts",
      "import": "./dist/generated/prisma/client.js"
    }
  },
  "scripts": {
    "build": "pnpm prisma:generate && tsc -p tsconfig.build.json",
    "lint": "eslint src prisma.config.ts prisma.generate.config.ts",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate --config prisma.generate.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:validate": "prisma validate --config prisma.generate.config.ts",
    "typecheck": "pnpm prisma:generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/pg": "8.23.1",
    "dotenv": "17.2.3",
    "prisma": "7.10.0",
    "typescript": "5.9.3"
  }
}
